<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_menu_bg"
    android:clickable="true">

    <include layout="@layout/hud" />

    <ImageView
        android:id="@+id/shadow_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/control_settings_shadow_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/shadow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:scaleX="1.5"
        android:src="@drawable/control_settings_shadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1879"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.4531" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/control_settings_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_11sdp"
        app:layout_constraintEnd_toEndOf="@+id/shadow"
        app:layout_constraintHeight_percent="0.0537"
        app:layout_constraintStart_toStartOf="@+id/shadow"
        app:layout_constraintTop_toTopOf="@+id/shadow"
        app:layout_constraintWidth_percent="0.39375">

        <ImageView
            android:id="@+id/save_icon"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/control_settings_save_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="1.0"
            app:layout_constraintStart_toEndOf="@+id/save_text"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/save_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akrobat_bold"
            android:text="Можно перемещать только элементы, которые выделены"
            android:textColor="@color/white"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/save_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/exit_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/control_settings_exit_btn"
        android:fontFamily="@font/akrobat_extra_bold"
        android:text="ВЫЙТИ"
        android:textColor="@color/white"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintEnd_toStartOf="@+id/save_btn"
        app:layout_constraintHeight_percent="0.0722"
        app:layout_constraintStart_toStartOf="@+id/control_settings_title"
        app:layout_constraintTop_toBottomOf="@+id/control_settings_title"
        app:layout_constraintWidth_percent="0.1067" />

    <Button
        android:id="@+id/save_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/control_settings_save_btn"
        android:fontFamily="@font/akrobat_extra_bold"
        android:text="СОХРАНИТЬ"
        android:textColor="@color/white"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="@+id/control_settings_title"
        app:layout_constraintHeight_percent="0.0722"
        app:layout_constraintStart_toEndOf="@+id/exit_btn"
        app:layout_constraintTop_toBottomOf="@+id/control_settings_title"
        app:layout_constraintWidth_percent="0.1067" />
</androidx.constraintlayout.widget.ConstraintLayout>
