<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="22dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <View
        android:id="@+id/chat_type_bar"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_chat_type_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/chat_time"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chat_time"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="02:54"
        android:textColor="@color/chat_time_text"
        android:textSize="11sp"
        android:fontFamily="@font/halvar_medium"
        app:layout_constraintStart_toEndOf="@id/chat_type_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/chat_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@font/halvar_medium"
        android:text="[Echo_Cross] [5]: Привет тестим чат все гуд ! Но не точно "
        android:textColor="@color/chat_feed_text"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/chat_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
