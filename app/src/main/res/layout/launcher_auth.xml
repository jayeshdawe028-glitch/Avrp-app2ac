<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fon_auth"
    tools:ignore="HardcodedText">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.0" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.98" />

    <!-- BACK (компактнее) -->


    <!-- NOTICE (меньше) -->

    <!-- TELEGRAM CARD (компактнее) -->

    <!-- AUTLOGIN -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnBack"
        android:layout_width="80dp"
        android:layout_height="69dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rectangle2029"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintStart_toStartOf="@id/gLeft"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBackIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/auth_back_button_ic"
            android:padding="9dp"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/akrobat_extra_bold"
            android:includeFontPadding="false"
            android:text="НАЗАД"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBackIcon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/authLeftNotice"
        android:layout_width="168dp"
        android:layout_height="59dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/group480966156"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        app:layout_constraintStart_toStartOf="@id/gLeft"
        app:layout_constraintTop_toBottomOf="@id/btnBack">


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tgCard"
        android:layout_width="145dp"
        android:layout_height="183dp"
        android:layout_marginTop="112dp"
        android:background="@drawable/bg_auth_center_card"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toStartOf="@id/characterImage"
        app:layout_constraintHorizontal_bias="0.739"
        app:layout_constraintStart_toStartOf="@id/gLeft"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivTgIcon"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tg_paperplane_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTgTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/akrobat_extra_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="АККАУНТ"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivTgIcon" />

        <TextView
            android:id="@+id/tvTgTitle2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/akrobat_extra_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="TELEGRAM"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTgTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvAutoLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/akrobat_extra_bold"
        android:includeFontPadding="false"
        android:text="АВТОВХОД ЧЕРЕЗ TELEGRAM"
        android:textAllCaps="true"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/tgCard"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/tgCard"
        app:layout_constraintTop_toBottomOf="@id/tgCard" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swAutoLogin"
        android:layout_width="39dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:checked="true"
        app:layout_constraintBaseline_toBaselineOf="@id/tvAutoLogin"
        app:layout_constraintStart_toEndOf="@id/tvAutoLogin"
        app:thumbTint="@color/white"
        app:trackTint="@color/yellow"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <ImageView
        android:id="@+id/characterImage"
        android:layout_width="193dp"
        android:layout_height="326dp"
        android:layout_marginEnd="16dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/login_pers"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />


</androidx.constraintlayout.widget.ConstraintLayout>
