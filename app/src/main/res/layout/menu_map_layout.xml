<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menu_map_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:id="@+id/back_btn"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:background="@drawable/main_menu_shield_bg"
        android:clickable="true"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_shadow"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.08703"
        app:layout_constraintWidth_percent="0.1484">

        <ImageView
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:adjustViewBounds="true"
            android:src="@drawable/auth_back_button_ic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:fontFamily="@font/akrobat_bold"
            android:text="вернуться"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/_9sdp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bottom_shadow"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.2314" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menu_map_selector"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:background="@drawable/menu_map_selector_bg"
        android:clickable="true"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_shadow"
        app:layout_constraintEnd_toEndOf="@+id/bottom_shadow"
        app:layout_constraintHeight_percent="0.087"
        app:layout_constraintWidth_percent="0.202">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text="карта ( метки )"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/_9sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/menu_map_selector_arrow"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_9sdp"
            android:src="@drawable/menu_map_selector_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/map_icons_container"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginBottom="@dimen/_6sdp"
        android:background="@drawable/menu_map_icons_bg"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/menu_map_selector"
        app:layout_constraintEnd_toEndOf="@+id/menu_map_selector"
        app:layout_constraintHeight_percent="0.8333"
        app:layout_constraintStart_toStartOf="@+id/menu_map_selector">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/map_icons_rc"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:clickable="true"
            android:fadingEdgeLength="@dimen/_10sdp"
            android:paddingStart="@dimen/_4sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_4sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:requiresFadingEdge="vertical"
            android:scrollbarThumbVertical="@drawable/menu_map_scroll_thumb"
            android:scrollbarTrackVertical="@drawable/menu_map_scroll_track"
            android:scrollbars="vertical"
            android:verticalScrollbarPosition="left"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>