        app:layout_constraintStart_toStartOf="@id/hud_timer_container" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hud_timer_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_3sdp"
        android:background="@drawable/hud_time_bg"
        android:minWidth="@dimen/_37sdp"
        android:translationY="@dimen/_2sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/server_number"
        app:layout_constraintHeight_percent="0.037"
        app:layout_constraintStart_toEndOf="@id/server_number"
        app:layout_constraintWidth_percent="0.0713">

        <ImageView
            android:id="@+id/clock_icon"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/_3sdp"
