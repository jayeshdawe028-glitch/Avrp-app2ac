            android:layout_height="wrap_content"
            android:fontFamily="@font/akrobat_extra_bold"
            android:paddingStart="@dimen/_2sdp"
            android:paddingEnd="@dimen/_3sdp"
            android:text="11:52 14:05.24"
            android:textColor="@color/white"
            android:textSize="@dimen/_5sdp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/clock_icon"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- GPS -->
    <LinearLayout
        android:id="@+id/gps_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/hp_container"
        app:layout_constraintTop_toBottomOf="@id/hp_container">

        <ImageView
            android:id="@+id/gps_icon"
            android:layout_width="@dimen/_5sdp"
            android:layout_height="@dimen/_6sdp"
            android:src="@drawable/hud_geo_ic" />

        <TextView
            android:id="@+id/gps_meters_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text="641 м"
            android:textColor="@color/white"
            android:textSize="@dimen/_8sdp" />
    </LinearLayout>

    <!-- VOICE BUTTON -->
    <ImageView
        android:id="@+id/voiceBtn"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/control_settings_voice_btn"
        app:layout_constraintStart_toEndOf="@id/hp_container"
        app:layout_constraintTop_toBottomOf="@id/weapon_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
