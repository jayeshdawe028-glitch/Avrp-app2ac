        android:layout_width="0dp"
        android:layout_height="0dp"
        android:translationX="@dimen/_6sdp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/radar_disk"
        app:layout_constraintEnd_toEndOf="@id/radar_disk"
        app:layout_constraintHeight_percent="0.2046"
        app:layout_constraintHorizontal_bias="0.241"
        app:layout_constraintStart_toEndOf="@id/radar_disk"
        app:layout_constraintTop_toTopOf="@id/radar_disk"
        app:layout_constraintVertical_bias="0.516"
        app:layout_constraintWidth_percent="0.04">

        <ImageView
            android:id="@+id/star_6"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_star_opacity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.1447"
            app:layout_constraintHorizontal_bias="0.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/star_5"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_star_opacity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.1447"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2" />

        <ImageView
            android:id="@+id/star_4"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_star_opacity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.1447"
            app:layout_constraintHorizontal_bias="0.62"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4" />

        <ImageView
            android:id="@+id/star_3"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_star_opacity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.1447"
            app:layout_constraintHorizontal_bias="0.62"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.61" />

        <ImageView
            android:id="@+id/star_2"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_star_opacity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.1447"
            app:layout_constraintHorizontal_bias="0.45"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.82" />

        <ImageView
            android:id="@+id/star_1"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_star_yellow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.1447"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menu_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/hud_opacity_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.095"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.045">

        <ImageView
            android:id="@+id/menu_btn_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_menu_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.55" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quest_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:background="@drawable/hud_opacity_btn"
        app:layout_constraintEnd_toStartOf="@id/menu_btn"
        app:layout_constraintHeight_percent="0.095"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.045">

        <ImageView
            android:id="@+id/quest_btn_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/hud_quest_icon"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.6" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tablet_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:background="@drawable/hud_opacity_btn"
        app:layout_constraintEnd_toStartOf="@id/quest_btn"
        app:layout_constraintHeight_percent="0.095"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.045">

        <ImageView
            android:id="@+id/tablet_btn_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_tablet_icon"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.6176" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/hus_shop_red_circle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="@dimen/_1sdp"
        android:src="@drawable/hud_shop_red_circle"
        android:translationX="@dimen/_4sdp"
        android:translationY="@dimen/_10sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/shop_btn"
        app:layout_constraintEnd_toEndOf="@id/shop_btn"
        app:layout_constraintHeight_percent="0.04007"
        app:layout_constraintWidth_percent="0.020541" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shop_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:background="@drawable/hud_green_btn"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/tablet_btn"
        app:layout_constraintHeight_percent="0.095"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.045">

        <ImageView
            android:id="@+id/shop_btn_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_shop_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.55" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inventory_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:background="@drawable/hud_opacity_btn"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/shop_btn"
        app:layout_constraintHeight_percent="0.095"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.045">

        <ImageView
            android:id="@+id/inventory_btn_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/hud_inventory_icon"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5882" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MONEY -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/money_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="@drawable/hud_money_bg"
        android:minWidth="@dimen/_60sdp"
        app:layout_constraintEnd_toEndOf="@id/menu_btn"
        app:layout_constraintHeight_percent="0.0611"
        app:layout_constraintTop_toBottomOf="@id/menu_btn">

        <ImageView
            android:id="@+id/hud_money_icon_bg"
            android:layout_width="@dimen/_11sdp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_money_icon_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/money_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text="15.000"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/money_count_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/money_count_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text=" "
            android:textColor="@color/white"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="@id/hud_money_icon_bg"
            app:layout_constraintEnd_toEndOf="@id/hud_money_icon_bg"
            app:layout_constraintStart_toStartOf="@id/hud_money_icon_bg"
            app:layout_constraintTop_toTopOf="@id/hud_money_icon_bg" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/money_plus_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_5sdp"
        android:minWidth="@dimen/_32sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/money_container"
        app:layout_constraintHeight_percent="0.037"
        app:layout_constraintTop_toBottomOf="@id/money_container">

        <TextView
            android:id="@+id/money_plus_count"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/_5sdp"
            android:background="@drawable/hud_plus_bg"
            android:fontFamily="@font/akrobat_extra_bold"
            android:gravity="center"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:text="13.900 ₽"
            android:textColor="@color/white"
            android:textSize="@dimen/_6sdp"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/money_plus_bg"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_plus_icon_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.75"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/money_plus_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="@dimen/_9sdp"
            app:layout_constraintBottom_toBottomOf="@id/money_plus_bg"
            app:layout_constraintEnd_toEndOf="@id/money_plus_bg"
            app:layout_constraintStart_toStartOf="@id/money_plus_bg"
            app:layout_constraintTop_toTopOf="@id/money_plus_bg" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SERVER LOGO BLOCK -->
    <ImageView
        android:id="@+id/server_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_7sdp"
        android:src="@drawable/logotype_horse_shadow"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.0812"
