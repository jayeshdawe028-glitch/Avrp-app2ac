<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hud"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

    <!-- GUIDELINES -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/start_hud_v_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.04" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/chat_vertical_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.29" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/start_hud_h_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.032" />

    <!-- BOTTOM LEFT: SERVER + DATE -->
    <TextView
        android:id="@+id/current_server_and_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_8sdp"
        android:fontFamily="@font/akrobat_bold"
        android:text="Тестовый | ID: 0"
        android:textAllCaps="true"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:fontFamily="@font/akrobat_bold"
        android:text=" | Vlad Cross"
        android:textColor="#80ffffff"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/current_server_and_id" />

    <!-- RADAR -->
    <ImageView
        android:id="@+id/radar_disk"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:src="@drawable/hud_radar_circle"
        android:visibility="visible"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toStartOf="@id/start_hud_v_line"
        app:layout_constraintTop_toTopOf="@id/start_hud_h_line" />

    <!-- WEAPON -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weapon_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:translationY="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="@id/radar_disk"
        app:layout_constraintEnd_toEndOf="@id/radar_disk"
        app:layout_constraintHeight_percent="0.083"
        app:layout_constraintStart_toStartOf="@id/radar_disk"
        app:layout_constraintTop_toBottomOf="@id/radar_disk"
        app:layout_constraintWidth_percent="0.0441">

        <ImageView
            android:id="@+id/cartridge_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/hud_cartridges_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.6133"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/weapon"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/weapon_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5866"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cartridge_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_3sdp"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text="∞ / -"
            android:textColor="@color/white"
            android:textSize="@dimen/_7sdp"
            app:layout_constraintBottom_toBottomOf="@id/cartridge_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/cartridge_bg" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- HP -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hp_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_1sdp"
        android:layout_marginEnd="@dimen/_2sdp"
        android:background="@drawable/hud_health_bg"
        android:translationY="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="@id/weapon_container"
        app:layout_constraintEnd_toStartOf="@id/weapon_container"
        app:layout_constraintHeight_percent="0.0427"
        app:layout_constraintWidth_percent="0.0499">

        <ImageView
            android:id="@+id/hp_icon"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_health"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4782" />

        <TextView
            android:id="@+id/hp_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text="9%"
            android:textColor="@color/white"
            android:textSize="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/hp_icon"
            app:layout_constraintHorizontal_bias="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ARMOR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/armor_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_1sdp"
        android:layout_marginStart="@dimen/_2sdp"
        android:background="@drawable/hud_armor_bg"
        android:translationY="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="@id/weapon_container"
        app:layout_constraintHeight_percent="0.0427"
        app:layout_constraintStart_toEndOf="@id/weapon_container"
        app:layout_constraintWidth_percent="0.0499">

        <ImageView
            android:id="@+id/armor_icon"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_armor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4782" />

        <TextView
            android:id="@+id/armor_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text="0%"
            android:textColor="@color/white"
            android:textSize="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.3"
            app:layout_constraintStart_toEndOf="@id/armor_icon"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- STARS -->

    <!-- TOP RIGHT BUTTONS -->
