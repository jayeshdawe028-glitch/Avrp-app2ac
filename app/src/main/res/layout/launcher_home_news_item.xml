<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/video_item" android:layout_width="@dimen/_96sdp" android:layout_height="@dimen/_55sdp"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView android:layout_width="fill_parent" android:layout_height="fill_parent" app:cardCornerRadius="@dimen/_5sdp">
        <ImageView android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@color/black" />

        <ImageView
            android:id="@+id/preview_image"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:foreground="#20000000"
            android:scaleType="fitXY"
            android:src="@drawable/launcher_home_video_example"
            android:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:fontFamily="@font/akrobat_extra_bold"
            android:text="Текст новости"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>