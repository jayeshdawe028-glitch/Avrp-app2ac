<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a">

    <ImageView
        android:id="@+id/decoration_left"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/bubble"
        android:alpha="0.4"
        android:rotation="45"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="-40dp"
        android:layout_marginTop="80dp"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/decoration_right"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/bubble"
        android:alpha="0.3"
        android:rotation="-20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="-80dp"
        android:layout_marginBottom="40dp"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/character_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/personazh"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.45"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/gradient_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_fade"
        app:layout_constraintStart_toStartOf="@id/character_image"
        app:layout_constraintEnd_toEndOf="@id/character_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintStart_toEndOf="@id/character_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/loader_logo"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/hud_logo"
            android:layout_marginBottom="18dp"
            tools:ignore="ContentDescription"/>

        <TextView
            android:id="@+id/loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Кеш."
            android:textSize="15sp"
            android:textColor="#C5A253"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_gold"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="20sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
