<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#8A8F96"/>
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30FFC07A"
                android:centerColor="#14FFC07A"
                android:endColor="#00FFC07A"/>
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="28dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#00000000"
                android:centerColor="#00000000"
                android:endColor="#1A000000"/>
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF"/>
        </shape>
    </item>

</layer-list>
