<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Прозрачная база -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
        </shape>
    </item>

    <!-- Виньетка тени в правом верхнем углу -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="0.0"
                android:gradientRadius="320dp"
                android:startColor="#7A000000"
                android:centerColor="#40000000"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Виньетка тени в левом нижнем углу -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="1.0"
                android:gradientRadius="320dp"
                android:startColor="#7A000000"
                android:centerColor="#40000000"
                android:endColor="#00000000"/>
        </shape>
    </item>

</layer-list>
