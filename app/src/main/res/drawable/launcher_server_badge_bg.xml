<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <corners android:radius="12dp"/>
            <gradient
                android:angle="0"
                android:startColor="#3DFF2B2B"
                android:endColor="#00FF2B2B"/>
        </shape>
    </item>

    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="11dp"/>
            <solid android:color="#B3121216"/>
            <stroke android:width="1dp" android:color="#22FFFFFF"/>
        </shape>
    </item>

</layer-list>
