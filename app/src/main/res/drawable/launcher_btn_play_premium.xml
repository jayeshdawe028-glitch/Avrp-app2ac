<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- shadow -->
    <item android:top="6dp">
        <shape>
            <corners android:radius="18dp"/>
            <solid android:color="#55000000"/>
        </shape>
    </item>

    <!-- main -->
    <item>
        <shape>
            <corners android:radius="18dp"/>
            <gradient
                android:angle="0"
                android:startColor="#FF2B2B"
                android:endColor="#A80000"/>
            <stroke android:width="1dp" android:color="#22FFFFFF"/>
        </shape>
    </item>

    <!-- highlight -->
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape>
            <corners android:radius="17dp"/>
            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

</layer-list>
