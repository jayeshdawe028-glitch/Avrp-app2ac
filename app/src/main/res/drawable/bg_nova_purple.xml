<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#C4000000" />
        </shape>
    </item>

    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="0"
                android:startColor="#101026"
                android:centerColor="#16102A"
                android:endColor="#0E0818" />
            <stroke android:width="1dp" android:color="#8B3DFF" />
        </shape>
    </item>

</layer-list>
