<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp"/>
            <solid android:color="#33000000"/>
        </shape>
    </item>

    <!-- Phone body -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="34dp"/>
            <gradient
                android:angle="270"
                android:startColor="#2C2F36"
                android:centerColor="#16181D"
                android:endColor="#0B0C0F"/>
            <stroke android:width="1dp" android:color="#55FFFFFF"/>
        </shape>
    </item>

</layer-list>
