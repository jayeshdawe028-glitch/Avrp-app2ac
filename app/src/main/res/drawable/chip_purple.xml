<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#2A0F46" />
                    <stroke android:width="1dp" android:color="#B56CFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#151022" />
                    <stroke android:width="1dp" android:color="#6E28D9" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
