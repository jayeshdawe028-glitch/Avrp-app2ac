<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:thicknessRatio="26.0" android:useLevel="false">
            <size android:height="@dimen/_42sdp" android:width="@dimen/_42sdp" />
            <solid android:color="#ff2c2a33" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="90.0" android:toDegrees="90.0">
            <shape android:shape="ring" android:thicknessRatio="26.0" android:useLevel="true">
                <size android:height="@dimen/_42sdp" android:width="@dimen/_42sdp" />
                <gradient android:startColor="#ffffec2d" android:endColor="#ffff7a00" android:angle="90.0" />
                <corners android:radius="@dimen/_10sdp" />
            </shape>
        </rotate>
    </item>
    <item>
        <rotate>
            <inset android:insetBottom="211.0dip">
                <shape android:shape="ring" android:innerRadiusRatio="1000.0" android:useLevel="false" android:thickness="7.0dip">
                    <solid android:color="@color/black" />
                </shape>
            </inset>
        </rotate>
    </item>
</layer-list>